# Copy to .env and fill in real values. NEVER commit .env.
# Placeholders only.

# MinIO (raw / curated / quality object storage)
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme-at-least-8-chars
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=datalake

# MongoDB (serving layer)
MONGO_INITDB_ROOT_USERNAME=changeme
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_URI=mongodb://changeme:changeme@mongodb:27017/?authSource=admin
MONGO_DB=cfpb

# Spark (size for a student laptop; lower to 2g on 8 GB RAM machines)
SPARK_DRIVER_MEMORY=4g

# dev | ci | demo
APP_ENV=dev
