{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historical load manifest",
  "type": "object",
  "required": ["run_id", "source_url", "download_started_at", "download_finished_at",
               "archive_path", "archive_bytes", "archive_sha256", "extracted_path",
               "extracted_bytes", "extracted_sha256", "record_count", "header", "code_version"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^full_[0-9]{8}T[0-9]{6}Z_[0-9a-f]{6}$"},
    "source_url": {"type": "string"},
    "download_started_at": {"type": "string"},
    "download_finished_at": {"type": "string"},
    "archive_path": {"type": "string", "pattern": "^raw/cfpb/full_load/ingest_date=[0-9]{4}-[0-9]{2}-[0-9]{2}/run_id=[^/]+/complaints\\.csv\\.zip$"},
    "archive_bytes": {"type": "integer", "minimum": 1},
    "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "extracted_path": {"type": "string"},
    "extracted_bytes": {"type": "integer", "minimum": 1},
    "extracted_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_count": {"type": "integer", "minimum": 0},
    "header": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "code_version": {"type": "string"}
  }
}
